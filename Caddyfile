# Caddyfile
domianmt5.xyz {
    # LOGGING FIRST - so we see everything
    log {
        output stdout
        format json
        level INFO
    }
    
    # GZIP ENCODING - early in the chain
    encode gzip
    
    # HEADERS - set before handling requests
    header {
        # Remove any Access-Control-* headers that Caddy might add
        -Access-Control-Allow-Origin
        -Access-Control-Allow-Methods
        -Access-Control-Allow-Headers
        -Access-Control-Allow-Credentials
        -Access-Control-Max-Age
    }
    
    # OPTIONS PREFLIGHT HANDLER - MUST COME BEFORE reverse_proxy
    @preflight {
        method OPTIONS
    }
    handle @preflight {
        respond 204
    }
    
    # HEALTH CHECK ENDPOINT - handle separately if needed
    handle /health {
        reverse_proxy macro:8000 {
            health_uri /health
        }
    }
 
    # DEFAULT HANDLER - catch all other routes
    handle {
        reverse_proxy macro:8000 {
            lb_policy round_robin
            
            health_uri /health
            health_interval 10s
            health_timeout 5s
            health_status 200
            
            transport http {
                keepalive 60s
                keepalive_idle_conns 10
            }
            
            header_up -Access-Control-*
        }
    }
    
    # TLS configuration (Caddy handles this automatically)
    tls {
        protocols tls1.2 tls1.3
    }
}